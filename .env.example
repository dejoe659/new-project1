# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never put real values in GitHub.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site and security
SITE_URL=https://dcf-unn-site.vercel.app
CRON_SECRET=
UNSUBSCRIBE_SECRET=

# Email (Gmail)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# SMS (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=
TERMII_BASE_URL=
TERMII_WEBHOOK_SECRET=
TERMII_WEBHOOK_TOKEN=

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=dcf_followup
WHATSAPP_LANG=en
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=

# Automatic sending switches (leave unset = off)
AUTO_WELCOME=
AUTO_FOLLOWUP=
AUTO_VISITOR_THANKS=
AUTO_CHANNELS=
AUTO_VISITOR_CHANNELS=
AUTO_MESSAGE=
WELCOME_MESSAGE=
VISITOR_THANKS_MESSAGE=
